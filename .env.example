# Токен бота Telegram (получить у @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Список Telegram ID администраторов через запятую (получить свой ID у @userinfobot)
ADMIN_IDS=123456789,987654321

# Данные Telegram API по умолчанию (получить на https://my.telegram.org)
# Будут использоваться при добавлении аккаунтов, если не указаны индивидуальные
DEFAULT_API_ID=12345678
DEFAULT_API_HASH=0123456789abcdef0123456789abcdef

# Пути к файлам и папкам
DATABASE_PATH=data/bot.db
SESSIONS_DIR=sessions
MEDIA_DIR=media
